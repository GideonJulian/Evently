// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  // ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum TicketStatus {
  RESERVED
  PAID
  CANCELLED
  USED
}



model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String?    @map("password_hash")
  avatarUrl      String?    @map("avatar_url")
  role           UserRole   @default(USER)
  // organizedEvents Event[]   @relation("OrganizerEvents")
  tickets        Ticket[]
  favorites      Favorite[]
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

model Event {
  id               String       @id @default(cuid())
  title            String
  description      String
  category         String
  tags             String[]     @default([])
  imageUrl         String       @map("image_url")
  // organizerId      String       @map("organizer_id")
  // organizer        User         @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  location         String
  address          String
  latitude         Decimal      @db.Decimal(9, 6)
  longitude        Decimal      @db.Decimal(9, 6)
  eventDate        DateTime     @map("event_date") @db.Date
  startTime        String       @map("start_time")
  endTime          String       @map("end_time")
  ticketPrice      Decimal      @map("ticket_price") @db.Decimal(10, 2)
  totalTickets     Int          @map("total_tickets")
  ticketsRemaining Int          @map("tickets_remaining")
  status           EventStatus  @default(DRAFT)
  isFeatured       Boolean      @default(false) @map("is_featured")
  tickets          Ticket[]
  favorites        Favorite[]
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([category])
  @@index([eventDate])
  @@index([status, isFeatured])
  @@map("events")
}

model Ticket {
  id        String       @id @default(cuid())
  eventId   String       @map("event_id")
  userId    String       @map("user_id")
  quantity  Int          @default(1)
  totalPaid Decimal      @map("total_paid") @db.Decimal(10, 2)
  status    TicketStatus @default(RESERVED)
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([userId])
  @@map("tickets")
}

model Favorite {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@index([userId])
  @@map("favorites")
}

